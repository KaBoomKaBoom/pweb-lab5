ment account resources here\\n    # Development Account\\n    with Cluster(\\\"Development Account\\\", graph_attr={\\\"bgcolor\\\": COLOR_DEV + \\\"10\\\"}):\\n        # Add development account resources here\\n    # Staging Account\\n    with Cluster(\\\"Staging Account\\\", graph_attr={\\\"bgcolor\\\": COLOR_STAGING + \\\"10\\\"}):\\n        # Add staging account resources here\\n    # Production Account\\n    with Cluster(\\\"Production Account\\\", graph_attr={\\\"bgcolor\\\": COLOR_PROD + \\\"10\\\"}):\\n        # Add production account resources here\",\"hasDropCap\":null,\"dropCapImage\":null,\"markups\":[],\"codeBlockMetadata\":{\"__typename\":\"CodeBlockMetadata\",\"mode\":\"AUTO\",\"lang\":\"python\"},\"iframe\":null,\"mixtapeMetadata\":null},\"Paragraph:04d97583346b_33\":{\"__typename\":\"Paragraph\",\"id\":\"04d97583346b_33\",\"name\":\"aa9f\",\"type\":\"H3\",\"href\":null,\"layout\":null,\"metadata\":null,\"text\":\"Iteration 1: Adding management account resources\",\"hasDropCap\":null,\"dropCapImage\":null,\"markups\":[],\"codeBlockMetadata\":null,\"iframe\":null,\"mixtapeMetadata\":null},\"Paragraph:04d97583346b_34\":{\"__typename\":\"Paragraph\",\"id\":\"04d97583346b_34\",\"name\":\"f173\",\"type\":\"P\",\"href\":null,\"layout\":null,\"metadata\":null,\"text\":\"Continued by adding resources to the Management Account:\",\"hasDropCap\":null,\"dropCapImage\":null,\"markups\":[],\"codeBlockMetadata\":null,\"iframe\":null,\"mixtapeMetadata\":null},\"Paragraph:04d97583346b_35\":{\"__typename\":\"Paragraph\",\"id\":\"04d97583346b_35\",\"name\":\"47ee\",\"type\":\"PRE\",\"href\":null,\"layout\":null,\"metadata\":null,\"text\":\"# Management Account (Master Account)\\nwith Cluster(\\\"Management Account\\\", graph_attr={\\\"bgcolor\\\": COLOR_MANAGEMENT + \\\"10\\\"}):\\n    orgs = Organizations(\\\"AWS Organizations\\\")\\nwith Cluster(\\\"Centralized Management\\\"):\\n        iam_identity = IdentityAndAccessManagementIam(\\\"IAM Identity Center\\\")\\n  